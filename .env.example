# Copy to server/.env and adjust. Never commit server/.env.

# ── Server ──
PORT=5000
NODE_ENV=development
# Comma-separated list of browser origins allowed to call the API
CLIENT_URL=http://localhost:5173
# Set to 1 (or the number of proxies) when running behind a reverse proxy / load balancer
# TRUST_PROXY=1

# ── Database ──
MONGO_URI=mongodb://localhost:27017/simplyaid

# ── Authentication ──
# Required. Use a long random value, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-64-character-random-hex-string
JWT_EXPIRE=7d
# Allow people to create their own (employee) account with the company code
ALLOW_SELF_SIGNUP=true
# Password-less demo sign-in panel. Development only — refused when NODE_ENV=production.
ENABLE_DEMO_LOGIN=false

# ── Monitoring (expiry / low stock / inspections / compliance) ──
# How often the scheduled check runs (hours). Alerts are never duplicated.
MONITOR_INTERVAL_HOURS=6
# DISABLE_SCHEDULER=true

# ── Rate limits (requests per 15 minutes per IP) ──
# AUTH_RATE_LIMIT=30
# API_RATE_LIMIT=3000
